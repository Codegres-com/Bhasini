@page "/"
@page "/{Slug}"
@inject TypingSession Session
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject TranslationClient Translator
@implements IDisposable

<PageTitle>@(landing?.Title ?? "Bhasini — Type in all 22 Indian languages")</PageTitle>

<div id="main-toolbar" class="toolbar">
    <div class="toolbar-group">
        <button class="btn btn-lang" @onclick="OpenLanguagePicker" title="Choose language">
            <span class="lang-native @Language.FontClass">@Language.NativeName</span>
            <span class="lang-name">@Language.Name</span>
            <span class="bi bi-chevron-down"></span>
        </button>
    </div>

    <div class="toolbar-group">
        <div class="btn-group method-switch" role="group" aria-label="Input method">
            <button class="btn @(Session.Method == InputMethod.Phonetic && !Language.IsEnglish ? "btn-primary" : "btn-outline-primary")"
                    disabled="@Language.IsEnglish" @onclick="() => SetMethod(InputMethod.Phonetic)"
                    title="Type how it sounds: namaste → @Language.Sample">Phonetic</button>
            <button class="btn @(Session.Method == InputMethod.Inscript ? "btn-primary" : "btn-outline-primary")"
                    disabled="@(!Language.SupportsInscript)" @onclick="() => SetMethod(InputMethod.Inscript)"
                    title="@(Language.SupportsInscript ? "Government-standard InScript keyboard" : "InScript is not defined for this script")">InScript</button>
            <button class="btn @(!Session.IsActive ? "btn-dark" : "btn-outline-dark")"
                    @onclick="() => SetMethod(InputMethod.English)" title="Type plain English (F9 toggles)">ABC</button>
        </div>
        @if (Language.DigitMapper != null)
        {
            <div class="form-check form-switch m-0" title="Type digits in the native script">
                <input class="form-check-input" type="checkbox" id="nativeDigits" checked="@Session.NativeDigits" @onchange="ToggleDigits">
                <label class="form-check-label small" for="nativeDigits">@NativeDigitSample<span class="btn-label"> digits</span></label>
            </div>
        }
    </div>

    @* On phones this becomes one swipeable row of icon buttons; on wider screens it lays out as before. *@
    <div class="toolbar-actions">
    <div class="toolbar-group">
        <div class="btn-group" role="group">
            <button class="btn btn-outline-secondary" @onclick='() => Editor("undo")' title="Undo"><span class="bi bi-arrow-counterclockwise"></span></button>
            <button class="btn btn-outline-secondary" @onclick='() => Editor("redo")' title="Redo"><span class="bi bi-arrow-clockwise"></span></button>
            <button id="btn-copy" class="btn btn-outline-secondary" title="Copy"><span class="bi bi-clipboard"></span></button>
        </div>
        <button class="btn @(showKeymap ? "btn-secondary" : "btn-outline-secondary")" @onclick="ToggleKeymap" title="Show the keys for this language">
            <span class="bi bi-keyboard"></span><span class="btn-label"> Keys</span>
        </button>
        <button class="btn btn-outline-secondary" @onclick="OpenConvert" title="Convert text between Indian scripts">
            <span class="bi bi-arrow-left-right"></span><span class="btn-label"> Convert</span>
        </button>
        <button class="btn btn-outline-secondary" @onclick="OpenTranslate" title="Translate between English and Indian languages">
            <span class="bi bi-translate"></span><span class="btn-label"> Translate</span>
        </button>
        @if (speechSupported && Language.SpeechLocale != null)
        {
            <button class="btn @(listening ? "btn-danger" : "btn-outline-secondary")" @onclick="ToggleSpeech" title="Dictate in @Language.Name">
                <span class="bi @(listening ? "bi-mic-fill" : "bi-mic")"></span><span class="btn-label"> @(listening ? "Stop" : "Speak")</span>
            </button>
        }
    </div>

    <div class="toolbar-group ms-auto">
        <InputFile OnChange="LoadDocument" class="d-none" id="fileUpload" accept=".txt,.docx,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
        <label for="fileUpload" class="btn btn-outline-secondary mb-0" title="Open a .txt or .docx file"><span class="bi bi-folder2-open"></span><span class="btn-label"> Open</span></label>
        <button class="btn btn-success" @onclick="() => showSave = true" title="Save as Word, text or web page"><span class="bi bi-download"></span> Save</button>
        @if (globalKeyboard != null)
        {
            <button class="btn @(globalKeyboard.Enabled ? "btn-warning" : "btn-outline-secondary")"
                    disabled="@(!globalKeyboard.Available)" @onclick='() => JS.InvokeVoidAsync("bhasini.desktop.toggle")'
                    title="Type @GlobalLanguageName in any application (browser, Word, Excel, …). Shortcut: F9">
                <span class="bi bi-globe"></span> Global mode: @(globalKeyboard.Enabled ? "ON" : "OFF")
            </button>
        }
    </div>
    </div>
</div>

<div class="status-bar">
    @if (Session.IsActive)
    {
        <span class="status-dot on"></span>
        <span class="status-typing">Typing <strong>@Language.Name</strong> in @Language.ScriptName (@MethodLabel)</span>
        @if (Session.Method == InputMethod.Phonetic && Language.SampleInput.Length > 0)
        {
            <span class="status-hint status-try">Try: <code>@Language.SampleInput</code> → <span class="@Language.FontClass">@Language.Sample</span></span>
        }
    }
    else
    {
        <span class="status-dot"></span>
        <span>Typing plain English</span>
    }
    <span class="status-hint ms-auto">F9 switches @Language.Name ⇄ English</span>
    @if (statusMessage != null)
    {
        <span class="status-message">@statusMessage</span>
    }
</div>

<div class="workspace">
    <div id="editor-wrapper" class="editor-wrapper">
        <div id="quill-editor"></div>
    </div>

    @if (showKeymap)
    {
        <aside class="keymap-panel">
            <div class="keymap-header">
                <div>
                    <div class="fw-semibold">@Language.Name keys</div>
                    <div class="small text-muted">@(Session.Method == InputMethod.Inscript ? "InScript layout" : "Phonetic") · tap a letter to insert it</div>
                </div>
                <button class="btn-close" @onclick="ToggleKeymap" aria-label="Close"></button>
            </div>
            <div class="keymap-body">
                @if (Language.IsEnglish)
                {
                    <p class="text-muted small">English needs no key map. Pick an Indian language to see its keys.</p>
                }
                else if (Session.Method == InputMethod.Inscript)
                {
                    @foreach (var (row, shiftRow) in InscriptLayout.Rows.Zip(InscriptLayout.ShiftRows))
                    {
                        <div class="inscript-row">
                            @for (int i = 0; i < row.Length; i++)
                            {
                                var key = row[i];
                                var shiftKey = shiftRow[i];
                                var lower = InscriptOutput(key);
                                var upper = InscriptOutput(shiftKey);
                                <div class="inscript-key">
                                    <span class="ik-upper @Language.FontClass" @onclick="() => InsertGlyph(upper)">@upper</span>
                                    <span class="ik-lower @Language.FontClass" @onclick="() => InsertGlyph(lower)">@lower</span>
                                    <span class="ik-label">@key</span>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    @foreach (var group in Language.Phonetic!.Keymap)
                    {
                        <div class="keymap-group-title">@group.Title</div>
                        <div class="keymap-grid">
                            @foreach (var entry in group.Entries)
                            {
                                <button class="keymap-cell" @onclick="() => InsertGlyph(entry.Output)" title="Insert @entry.Output">
                                    <span class="km-out @Language.FontClass" dir="auto">@entry.Output</span>
                                    @if (entry.Note != null)
                                    {
                                        <span class="km-note @Language.FontClass" dir="auto">@entry.Note</span>
                                    }
                                    <span class="km-keys">@entry.Keys</span>
                                </button>
                            }
                        </div>
                    }
                    @if (Language.Phonetic is BrahmicPhoneticEngine)
                    {
                        <div class="keymap-note small text-muted">
                            Consonants join automatically: <code>kSh</code>, <code>str</code>, <code>ndr</code>.
                            Use <code>_</code> to keep letters apart, <code>.h</code> for an explicit virama,
                            and <code>|</code> / <code>||</code> for danda.
                        </div>
                    }
                }
            </div>
        </aside>
    }
</div>

@if (showLanguagePicker)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1" @onclick="CloseModals">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl modal-fullscreen-sm-down language-modal" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">Choose a language</h5>
                        <div class="small text-muted">The 22 languages in the Eighth Schedule of the Constitution of India, plus English</div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    <input class="form-control mb-3" placeholder="Search languages or scripts…" @bind="languageFilter" @bind:event="oninput" />
                    <div class="language-grid">
                        @foreach (var lang in FilteredLanguages)
                        {
                            <button class="language-tile @(lang == Language ? "active" : "")" @onclick="() => ChooseLanguage(lang)">
                                <span class="lt-native @lang.FontClass" dir="auto">@lang.NativeName</span>
                                <span class="lt-name">@lang.Name</span>
                                <span class="lt-meta">@lang.ScriptName</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (showSave)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Save document</h5>
                    <button type="button" class="btn-close" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    <label for="filenameInput" class="form-label">File name</label>
                    <input type="text" class="form-control mb-3" id="filenameInput" @bind="saveFileName">
                    <div class="d-grid gap-2">
                        <button class="btn btn-primary" @onclick="DownloadDocx"><span class="bi bi-file-earmark-word"></span> Word document (.docx)</button>
                        <button class="btn btn-outline-primary" @onclick="DownloadTxt"><span class="bi bi-file-earmark-text"></span> Plain text (.txt)</button>
                        <button class="btn btn-outline-primary" @onclick="DownloadHtml"><span class="bi bi-filetype-html"></span> Web page (.html)</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (showConvert)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><span class="bi bi-arrow-left-right me-2"></span>Convert text</h5>
                    <button type="button" class="btn-close" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small text-muted">Convert</label>
                    <select class="form-select mb-3" @bind="convertMode">
                        <option value="script">Indian script → another Indian script</option>
                        <option value="roman">Romanised text (e.g. "namaste") → native script</option>
                    </select>

                    <label class="form-label small text-muted">Into</label>
                    <select class="form-select mb-3" @bind="convertTarget">
                        @foreach (var lang in ConvertTargets)
                        {
                            <option value="@lang.Code">@lang.Name — @lang.NativeName (@lang.ScriptName)</option>
                        }
                    </select>

                    <div class="small text-muted">
                        @(convertHasSelection ? "The selected text will be converted." : "Nothing is selected, so the whole document will be converted.")
                        @if (convertMode == "script")
                        {
                            <br /><span>Script conversion works letter by letter between Brahmic scripts and Meetei Mayek; sounds a script lacks use the nearest letter.</span>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModals">Cancel</button>
                    <button class="btn btn-primary" @onclick="RunConvert">Convert</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showTranslate)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><span class="bi bi-translate me-2"></span>Translate</h5>
                    <button type="button" class="btn-close" @onclick="CloseModals" disabled="@translating"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small text-muted" for="translateSource">From</label>
                    <select class="form-select mb-3" id="translateSource" @bind="translateSource" disabled="@translating">
                        <option value="auto">Detect language</option>
                        @foreach (var lang in LanguageCatalog.All)
                        {
                            <option value="@TranslateCode(lang)">@LanguageOption(lang)</option>
                        }
                    </select>

                    <label class="form-label small text-muted" for="translateTarget">Into</label>
                    <select class="form-select mb-3" id="translateTarget" @bind="translateTarget" disabled="@translating">
                        @foreach (var lang in LanguageCatalog.All)
                        {
                            <option value="@TranslateCode(lang)">@LanguageOption(lang)</option>
                        }
                    </select>

                    <div class="small text-muted">
                        @(translateHasSelection ? "The selected text will be replaced by its translation." : "Nothing is selected, so the whole document will be translated.")
                        Undo brings the original back.
                        <br /><span class="bi bi-cloud me-1"></span>Translation sends the text to Bhasini's server (AI4Bharat IndicTrans2 on Cloudflare). It is not stored.
                        Free: up to @TranslationClient.MaxCharacters.ToString("N0") characters at a time and @TranslationClient.FreeCharactersPerDay.ToString("N0") a day.
                    </div>
                    @if (translateError != null)
                    {
                        <div class="alert alert-warning small mt-3 mb-0" role="alert">@translateError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModals" disabled="@translating">Cancel</button>
                    <button class="btn btn-primary" @onclick="RunTranslate" disabled="@translating">
                        @if (translating)
                        {
                            <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span><span>Translating…</span>
                        }
                        else
                        {
                            <span>Translate</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Landing pages (/hindi-typing/, /tamil-keyboard/, …) open the editor in their language.
    [Parameter] public string? Slug { get; set; }

    SitePage? landing;
    string? loadedSlug;

    IndicLanguage Language => Session.Language;

    bool showKeymap;
    bool showLanguagePicker;
    bool showSave;
    bool showConvert;
    bool showTranslate;
    bool translating;
    string translateSource = "auto";
    string translateTarget = "en";
    bool translateHasSelection;
    string? translateError;
    bool speechSupported;
    bool listening;
    string languageFilter = "";
    string saveFileName = "Bhasini";
    string convertMode = "script";
    string convertTarget = "hi";
    bool convertHasSelection;
    string? statusMessage;
    InputMethod lastIndicMethod = InputMethod.Phonetic;
    DotNetObjectReference<Home>? selfRef;

    string MethodLabel => Session.Method == InputMethod.Inscript ? "InScript" : "Phonetic";

    string NativeDigitSample => string.Concat(Enumerable.Range(1, 3).Select(d => Language.NativeDigit(d)?.ToString() ?? ""));

    IEnumerable<IndicLanguage> FilteredLanguages => LanguageCatalog.All.Where(l =>
        languageFilter.Length == 0 ||
        l.Name.Contains(languageFilter, StringComparison.OrdinalIgnoreCase) ||
        l.ScriptName.Contains(languageFilter, StringComparison.OrdinalIgnoreCase) ||
        l.NativeName.Contains(languageFilter) ||
        l.Code.StartsWith(languageFilter, StringComparison.OrdinalIgnoreCase));

    IEnumerable<IndicLanguage> ConvertTargets => convertMode == "roman"
        ? LanguageCatalog.All.Where(l => !l.IsEnglish)
        : LanguageCatalog.All.Where(ScriptConverter.CanConvertTo);

    protected override void OnInitialized()
    {
        loadedSlug = Slug;
        landing = SitePages.Find(Slug);
    }

    protected override void OnParametersSet()
    {
        // Each landing page is its own static HTML file with its own text, so a link from one to
        // another (or back to the home page) loads that file instead of switching in place.
        if (!string.Equals(Slug, loadedSlug, StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        selfRef = DotNetObjectReference.Create(this);
        var settings = await JS.InvokeAsync<SavedSettings?>("bhasini.storage.load");
        if (settings != null)
        {
            Session.SetLanguage(LanguageCatalog.Get(settings.Language));
            if (Enum.TryParse<InputMethod>(settings.Method, out var method)) Session.SetMethod(method);
            Session.NativeDigits = settings.NativeDigits;
            showKeymap = settings.ShowKeymap;
        }
        if (landing?.Language != null)
        {
            Session.SetLanguage(landing.Language);
            if (Session.Method == InputMethod.English) Session.SetMethod(InputMethod.Phonetic);
            if (landing.ShowKeymap) showKeymap = true;
        }
        if (Session.Method != InputMethod.English) lastIndicMethod = Session.Method;

        await JS.InvokeVoidAsync("bhasini.editor.init", "#quill-editor", selfRef);
        await ApplyEditorLanguage();
        speechSupported = await JS.InvokeAsync<bool>("bhasini.speech.isSupported");

        // Windows app only: F9 Global mode types the editor's language in every application.
        globalKeyboard = await JS.InvokeAsync<GlobalKeyboardState?>("bhasini.desktop.init", selfRef);
        await SyncGlobalKeyboard();

        // Every launch starts by asking which language to type; the last one stays highlighted.
        // A language landing page has already answered that.
        if (landing?.Language == null) OpenLanguagePicker();
        StateHasChanged();
    }

    // ---- Called synchronously by the editor for every key ----

    [JSInvokable]
    public KeyResult? OnKey(string key) => key.Length == 1 ? Session.Key(key[0]) : null;

    [JSInvokable]
    public KeyResult? OnBackspace() => Session.Backspace();

    [JSInvokable]
    public void OnReset() => Session.Reset();

    [JSInvokable]
    public async Task OnToggleInput()
    {
        await SetMethod(Session.IsActive ? InputMethod.English : lastIndicMethod);
        StateHasChanged();
    }

    // ---- Language and method ----

    private void OpenLanguagePicker()
    {
        languageFilter = "";
        showLanguagePicker = true;
    }

    private async Task ChooseLanguage(IndicLanguage lang)
    {
        Session.SetLanguage(lang);
        // Picking a language means wanting to type it.
        if (!lang.IsEnglish && Session.Method == InputMethod.English) Session.SetMethod(lastIndicMethod);
        showLanguagePicker = false;
        if (listening) await JS.InvokeVoidAsync("bhasini.speech.stop");
        await ApplyEditorLanguage();
        await SaveSettings();
        await SyncGlobalKeyboard();
        await JS.InvokeVoidAsync("bhasini.editor.focus");
        await ShowLandingPageFor(lang);
    }

    // The instructions below the editor follow the language: /hindi-typing/ becomes /tamil-typing/
    // (the same kind of page where the language has one), with its text, title and URL, and the
    // editor keeps what was typed. The script converter page keeps its own text.
    private async Task ShowLandingPageFor(IndicLanguage lang)
    {
        if (landing?.Kind == SitePageKind.ScriptConverter) return;
        var target = SitePages.ForLanguage(lang, landing?.Kind);
        if (target == null || target == landing) return;
        try
        {
            if (!await JS.InvokeAsync<bool>("bhasini.site.load", target.Path)) return;
        }
        catch (JSException)
        {
            // An older cached editor.js without bhasini.site: keep the current page text.
            return;
        }

        landing = target;
        loadedSlug = target.Slug;
        Navigation.NavigateTo(target.Path);
    }

    private async Task SetMethod(InputMethod method)
    {
        Session.SetMethod(method);
        if (Session.Method != InputMethod.English) lastIndicMethod = Session.Method;
        await JS.InvokeVoidAsync("bhasini.editor.setActive", Session.IsActive);
        await SaveSettings();
        await SyncGlobalKeyboard();
        await JS.InvokeVoidAsync("bhasini.editor.focus");
    }

    // ---- Global (Direct Type) keyboard: Windows app only ----

    public sealed class GlobalKeyboardState
    {
        public bool Available { get; set; }
        public bool Enabled { get; set; }
        public string? Language { get; set; }
        public string? Method { get; set; }
    }

    GlobalKeyboardState? globalKeyboard;

    string GlobalLanguageName => LanguageCatalog.Get(globalKeyboard?.Language).Name;

    // Global mode follows the editor's language and keyboard (English keeps the last Indian language).
    private async Task SyncGlobalKeyboard()
    {
        if (globalKeyboard == null) return;
        if (!Language.IsEnglish && globalKeyboard.Language != Language.Code)
        {
            await JS.InvokeVoidAsync("bhasini.desktop.setLanguage", Language.Code);
        }
        if (Session.Method != InputMethod.English && globalKeyboard.Method != Session.Method.ToString())
        {
            await JS.InvokeVoidAsync("bhasini.desktop.setMethod", Session.Method.ToString());
        }
    }

    // State from the helper, including changes made from the tray menu.
    [JSInvokable]
    public async Task OnGlobalKeyboardState(GlobalKeyboardState state)
    {
        var previous = globalKeyboard;
        globalKeyboard = state;

        // The helper just (re)started: it takes the editor's language, not the other way round.
        if (previous == null || !previous.Available)
        {
            await SyncGlobalKeyboard();
            StateHasChanged();
            return;
        }

        // Otherwise only follow real changes, i.e. ones made from the tray menu.
        var language = LanguageCatalog.Get(state.Language);
        bool changed = false;
        if (state.Language != previous.Language && !language.IsEnglish && language != Language && !Language.IsEnglish)
        {
            Session.SetLanguage(language);
            changed = true;
        }
        if (state.Method != previous.Method && Session.IsActive && Enum.TryParse<InputMethod>(state.Method, out var method) && method != Session.Method)
        {
            Session.SetMethod(method);
            lastIndicMethod = Session.Method;
            changed = true;
        }
        if (changed)
        {
            await ApplyEditorLanguage();
            await SaveSettings();
        }
        StateHasChanged();
    }

    private async Task ToggleDigits(ChangeEventArgs e)
    {
        Session.NativeDigits = e.Value is bool b && b;
        await SaveSettings();
    }

    private async Task ToggleKeymap()
    {
        showKeymap = !showKeymap;
        await SaveSettings();
    }

    private async Task ApplyEditorLanguage()
    {
        await JS.InvokeVoidAsync("bhasini.editor.setLanguage", new
        {
            code = Language.Code,
            fontClass = Language.FontClass,
            rtl = Language.RightToLeft,
            active = Session.IsActive,
        });
    }

    private async Task SaveSettings()
    {
        await JS.InvokeVoidAsync("bhasini.storage.save", new SavedSettings
        {
            Language = Language.Code,
            Method = Session.Method.ToString(),
            NativeDigits = Session.NativeDigits,
            ShowKeymap = showKeymap,
        });
    }

    public sealed class SavedSettings
    {
        public string? Language { get; set; }
        public string? Method { get; set; }
        public bool NativeDigits { get; set; }
        public bool ShowKeymap { get; set; }
    }

    // ---- Keymap palette ----

    private string InscriptOutput(char key)
    {
        var deva = InscriptLayout.Map(key);
        return deva == null || Language.Mapper == null ? "" : Language.Mapper.FromDevanagari(deva, phonetic: false);
    }

    private async Task InsertGlyph(string text)
    {
        if (string.IsNullOrEmpty(text) || text.StartsWith("(")) return;
        var glyph = text.Replace("◌", "");
        Session.Reset();
        await JS.InvokeVoidAsync("bhasini.editor.insertText", glyph);
    }

    // ---- Editor commands ----

    private async Task Editor(string command) => await JS.InvokeVoidAsync("bhasini.editor." + command);

    private void CloseModals()
    {
        showLanguagePicker = false;
        showSave = false;
        showConvert = false;
        if (!translating) showTranslate = false;
    }

    private async Task DownloadDocx()
    {
        var html = await JS.InvokeAsync<string>("bhasini.editor.getHtml");
        await JS.InvokeVoidAsync("bhasini.files.saveDocx", FileName(".docx"), html);
        CloseModals();
    }

    private async Task DownloadTxt()
    {
        var text = await JS.InvokeAsync<string>("bhasini.editor.getText");
        await JS.InvokeVoidAsync("bhasini.files.download", FileName(".txt"), text, "text/plain;charset=utf-8");
        CloseModals();
    }

    private async Task DownloadHtml()
    {
        var html = await JS.InvokeAsync<string>("bhasini.editor.getHtml");
        var page = $"<!DOCTYPE html><html lang=\"{Language.Code}\"><head><meta charset=\"utf-8\"><title>{System.Net.WebUtility.HtmlEncode(saveFileName)}</title></head><body dir=\"{(Language.RightToLeft ? "rtl" : "ltr")}\">{html}</body></html>";
        await JS.InvokeVoidAsync("bhasini.files.download", FileName(".html"), page, "text/html;charset=utf-8");
        CloseModals();
    }

    private string FileName(string extension) => (string.IsNullOrWhiteSpace(saveFileName) ? "Bhasini" : saveFileName.Trim()) + extension;

    private async Task LoadDocument(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            await using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();

            string html;
            if (ext == ".docx")
            {
                html = await JS.InvokeAsync<string>("bhasini.files.docxToHtml", bytes);
            }
            else
            {
                var text = System.Text.Encoding.UTF8.GetString(bytes);
                html = string.Join("", text.Replace("\r\n", "\n").Split('\n')
                    .Select(line => "<p>" + (line.Length == 0 ? "<br>" : System.Net.WebUtility.HtmlEncode(line)) + "</p>"));
            }

            Session.Reset();
            await JS.InvokeVoidAsync("bhasini.editor.setHtml", html);
            saveFileName = Path.GetFileNameWithoutExtension(file.Name);
            ShowStatus($"Opened {file.Name}");
        }
        catch (Exception ex)
        {
            ShowStatus("Could not open the file: " + ex.Message);
        }
    }

    // ---- Script conversion ----

    private async Task OpenConvert()
    {
        var selected = await JS.InvokeAsync<string>("bhasini.editor.getSelectedText");
        convertHasSelection = !string.IsNullOrEmpty(selected);
        convertTarget = ConvertTargets.Contains(Language) ? Language.Code : "hi";
        showConvert = true;
    }

    private async Task RunConvert()
    {
        var target = LanguageCatalog.Get(convertTarget);
        var selected = await JS.InvokeAsync<string>("bhasini.editor.getSelectedText");
        bool whole = string.IsNullOrEmpty(selected);
        var source = whole ? await JS.InvokeAsync<string>("bhasini.editor.getText") : selected;

        var converted = convertMode == "roman"
            ? ScriptConverter.FromRoman(source, target)
            : ScriptConverter.ConvertScript(source, target);

        Session.Reset();
        if (whole) await JS.InvokeVoidAsync("bhasini.editor.setText", converted);
        else await JS.InvokeVoidAsync("bhasini.editor.replaceSelection", converted);

        CloseModals();
        ShowStatus($"Converted to {target.Name}");
    }

    // ---- Translation ----

    // The API takes "en" for English; every other language uses its catalog code.
    private static string TranslateCode(IndicLanguage lang) => lang.IsEnglish ? "en" : lang.Code;

    private static string LanguageOption(IndicLanguage lang) =>
        lang.IsEnglish ? "English" : $"{lang.Name} — {lang.NativeName}";

    private async Task OpenTranslate()
    {
        var selected = await JS.InvokeAsync<string>("bhasini.editor.getSelectedText");
        translateHasSelection = !string.IsNullOrEmpty(selected);
        translateError = null;
        // Typing in an Indian language usually means translating it into English, and vice versa.
        translateSource = "auto";
        translateTarget = Language.IsEnglish ? (translateTarget == "en" ? "hi" : translateTarget) : "en";
        showTranslate = true;
    }

    private async Task RunTranslate()
    {
        var selected = await JS.InvokeAsync<string>("bhasini.editor.getSelectedText");
        bool whole = string.IsNullOrEmpty(selected);
        var source = (whole ? await JS.InvokeAsync<string>("bhasini.editor.getText") : selected).TrimEnd('\n');

        if (string.IsNullOrWhiteSpace(source))
        {
            translateError = "There is no text to translate.";
            return;
        }
        if (source.EnumerateRunes().Count() > TranslationClient.MaxCharacters)
        {
            translateError = $"The text is longer than {TranslationClient.MaxCharacters:N0} characters. Select a part of it and translate that.";
            return;
        }

        translating = true;
        translateError = null;
        // The handler already yielded on the JS calls above, so show the spinner explicitly.
        StateHasChanged();
        try
        {
            var result = await Translator.TranslateAsync(source, translateSource, translateTarget);
            Session.Reset();
            if (whole) await JS.InvokeVoidAsync("bhasini.editor.setText", result.Translation);
            else await JS.InvokeVoidAsync("bhasini.editor.replaceSelection", result.Translation);

            translating = false;
            showTranslate = false;
            // Keep typing in the language just translated into (also sets right-to-left for Urdu, Kashmiri, Sindhi).
            var target = translateTarget == "en" ? LanguageCatalog.English : LanguageCatalog.Get(translateTarget);
            if (target != Language) await ChooseLanguage(target);
            ShowStatus(result.FreeCharsLeftToday is int left
                ? $"Translated into {target.Name} · {left:N0} free characters left today"
                : $"Translated into {target.Name}");
        }
        catch (TranslationException ex)
        {
            translateError = ex.Message;
        }
        finally
        {
            translating = false;
        }
    }

    // ---- Speech ----

    private async Task ToggleSpeech()
    {
        if (listening)
        {
            await JS.InvokeVoidAsync("bhasini.speech.stop");
        }
        else if (Language.SpeechLocale != null)
        {
            await JS.InvokeVoidAsync("bhasini.speech.start", Language.SpeechLocale, selfRef);
        }
    }

    [JSInvokable]
    public async Task OnSpeechResult(string text)
    {
        Session.Reset();
        await JS.InvokeVoidAsync("bhasini.editor.insertText", text + " ");
    }

    [JSInvokable]
    public void OnSpeechState(bool isListening, string? error)
    {
        listening = isListening;
        if (!string.IsNullOrEmpty(error)) ShowStatus(error == "language-not-supported"
            ? $"This browser cannot recognise {Language.Name} speech."
            : "Speech: " + error);
        StateHasChanged();
    }

    private CancellationTokenSource? statusCts;

    private async void ShowStatus(string message)
    {
        statusMessage = message;
        statusCts?.Cancel();
        var cts = statusCts = new CancellationTokenSource();
        StateHasChanged();
        try
        {
            await Task.Delay(4000, cts.Token);
            statusMessage = null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    public void Dispose()
    {
        statusCts?.Cancel();
        selfRef?.Dispose();
    }
}
